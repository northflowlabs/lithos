# Base URL of the LITHOS API.
NEXT_PUBLIC_LITHOS_API=http://localhost:8000
# Basemap raster tiles (light, scientific). Any {z}/{x}/{y} raster source works.
NEXT_PUBLIC_BASEMAP_LIGHT=https://basemaps.cartocdn.com/light_all/{z}/{x}/{y}.png
NEXT_PUBLIC_BASEMAP_DARK=https://basemaps.cartocdn.com/dark_all/{z}/{x}/{y}.png
