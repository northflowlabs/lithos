# LITHOS environment configuration. Copy to .env and fill in.
# The measured scenes are served WITHOUT any of these set.

# --- Copernicus EGMS (free, personal key) ---
# Create an API token in your profile at https://land.copernicus.eu and either point
# CLMS_SERVICE_KEY_FILE at the JSON file you receive or paste its contents, on one line,
# into CLMS_SERVICE_KEY. Needs the `egms` extra of pylithos-ingest, which the Docker image
# has. In Docker the file path must be one inside the container, so prefer CLMS_SERVICE_KEY.
CLMS_SERVICE_KEY_FILE=
CLMS_SERVICE_KEY=

# --- COMET LiCSAR (no account needed; public HTTP archive) ---
LICSAR_ARCHIVE_BASE=https://gws-access.jasmin.ac.uk/public/nceo_geohazards/LiCSAR_products.public
# Be a good citizen: requests/second cap when reading the LiCSAR archive.
LICSAR_RATE_LIMIT_RPS=2

# --- Data ---
# Where scenes live. Defaults to data/ in a source checkout.
# LITHOS_DATA_DIR=/app/data

# --- API ---
LITHOS_API_HOST=0.0.0.0
LITHOS_API_PORT=8000
LITHOS_API_CORS_ORIGINS=http://localhost:3000
LITHOS_LOG_LEVEL=INFO

# --- Web ---
NEXT_PUBLIC_LITHOS_API=http://localhost:8000
