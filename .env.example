# LITHOS environment configuration. Copy to .env and fill in.
# The hero scene renders from cached sample data WITHOUT any of these set.

# --- Copernicus / EGMS (free account: https://dataspace.copernicus.eu/) ---
# Required only to download fresh EGMS tiles beyond the cached hero scene.
EGMS_USERNAME=
EGMS_PASSWORD=
# EGMS machine-to-machine API base (override only if Copernicus changes it).
EGMS_API_BASE=https://egms.land.copernicus.eu/api

# --- COMET LiCSAR (no account needed; public HTTP archive) ---
LICSAR_PORTAL_BASE=https://gws-access.jasmin.ac.uk/public/nceo_geohazards/LiCSAR_products
# Be a good citizen: requests/second cap when crawling the LiCSAR archive.
LICSAR_RATE_LIMIT_RPS=2

# --- Storage ---
# Spatial store. "duckdb" (zero-config, default) or a PostGIS DSN.
LITHOS_STORE=duckdb
LITHOS_DUCKDB_PATH=data/lithos.duckdb
# POSTGIS_DSN=postgresql://lithos:lithos@db:5432/lithos

# --- API ---
LITHOS_API_HOST=0.0.0.0
LITHOS_API_PORT=8000
LITHOS_API_CORS_ORIGINS=http://localhost:3000
LITHOS_LOG_LEVEL=INFO

# --- Web ---
NEXT_PUBLIC_LITHOS_API=http://localhost:8000
